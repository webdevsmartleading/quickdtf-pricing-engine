    }

    if (MODE === 'popular' && !popularVariantId) {
      alert('Please select a popular size first.');
      return;
    }

    if (w <= 0 || h <= 0) {
      alert('Please enter a valid width and height.');
      return;
    }

    if (MODE === 'popular') setProductVariant(popularVariantId);

    setEasifyDimensions(w, h);
    setEasifyQty(qty);
