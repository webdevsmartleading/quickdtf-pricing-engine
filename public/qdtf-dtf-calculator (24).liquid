  // ── Add to cart + open drawer helper ─────────────────────────────────────
  var cartAddedMode = null;

  function openCartDrawer() {
    var drawer = document.querySelector('cart-drawer-component');

    // Use confirmed section ID for cart drawer
    var sectionEl = drawer && drawer.closest('[id^="shopify-section-"]');
    var sectionId = sectionEl
      ? sectionEl.id.replace('shopify-section-', '')
      : 'sections--19394943975537__header_section';

    fetch('/cart?sections=' + sectionId)
      .then(function(r) { return r.json(); })
      .then(function(sections) {
        var parser = new DOMParser();
        var rendered = false;

        // Try each section key for cart drawer content
        Object.keys(sections).forEach(function(key) {
          if (rendered) return;
          var doc = parser.parseFromString(sections[key], 'text/html');
          var newDrawer = doc.querySelector('cart-drawer-component');
          if (newDrawer && drawer) {
            drawer.innerHTML = newDrawer.innerHTML;
            rendered = true;
          }
          // Update cart icon bubble
          var newBubble = doc.querySelector('cart-icon-bubble');
          var existingBubble = document.querySelector('cart-icon-bubble');
          if (newBubble && existingBubble) {
            existingBubble.innerHTML = newBubble.innerHTML;
          }
        });

        // Open drawer
        var d = document.querySelector('cart-drawer-component');
        if (d) {
          if (typeof d.open === 'function') d.open();
          else {
            d.setAttribute('open', 'true');
            document.dispatchEvent(new CustomEvent('dispatch:cart-drawer:open', { bubbles: true }));
          }
        }
      })
      .catch(function() {
        // Fallback: trigger cart icon click
        var cartIcon = document.querySelector('a[href="/cart"], .header-actions__action[href*="cart"]');
        if (cartIcon) cartIcon.click();
      });
  }

  function addToCartAndOpen(variantId, qty, properties, btn, orig) {
    if (cartAddedMode && cartAddedMode !== MODE) {
      if (!window.confirm('You already added a ' + cartAddedMode + ' size to cart from this product. Add another?')) {
        if (btn) { btn.disabled = false; btn.innerHTML = orig; }
        return;
      }
    }
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: variantId, quantity: qty, properties: properties })
    })
    .then(function(r) { return r.json(); })
    .then(function() {
      cartAddedMode = MODE;
      if (btn) { btn.disabled = false; btn.innerHTML = '✓ Added!'; btn.style.background = '#16A34A'; }
      fetch('/cart.js').then(function(r) { return r.json(); }).then(function(cart) {
        document.dispatchEvent(new CustomEvent('cart:add', { bubbles: true, detail: { resource: cart } }));
        var d = document.querySelector('cart-drawer-component');
        if (d && d.open) d.open();
      });
      setTimeout(function() {
        if (btn) { btn.style.background = ''; btn.innerHTML = orig; }
      }, 2000);
    })
    .catch(function() {
      if (btn) { btn.disabled = false; btn.innerHTML = orig; }
      alert('Error adding to cart. Try again.');
    });
  }

  // ── Add to Cart ────────────────────────────────────────────────────────────
  var atcBtn = g('qdtf-atc-btn');
  if (atcBtn) atcBtn.addEventListener('click', function() {
    var btn  = this;
    var qty  = getQty();
    var orig = btn.innerHTML;
    var w    = MODE === 'popular' ? popularWidth  : getW();
    var h    = MODE === 'popular' ? popularHeight : getH();

    if (!fileUrl) {
      alert('Please upload your design first.');
