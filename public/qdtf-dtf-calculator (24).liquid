              setTimeout(function() {
                var drawer = document.querySelector('cart-drawer-component');
                if (drawer && typeof drawer.open === 'function') {
                  drawer.open();
                } else {
                  // Fallback: click the cart icon
                  var cartBtn = document.querySelector('.header-actions__action[href*="cart"], a[href="/cart"]');
                  if (cartBtn) cartBtn.click();
                }
              }, 300);
            });
          }, 500);
          setTimeout(function() { btn.style.background = ''; btn.innerHTML = orig; }, 2000);
        })
        .catch(function() { btn.disabled = false; btn.innerHTML = orig; alert('Error. Try again.'); });

      } else {
        // Discounted qty (15+) — create draft order then add placeholder to cart
        if (popularWidth <= 0 || popularHeight <= 0) { alert('Please select a size first.'); return; }
        btn.disabled = true; btn.innerHTML = 'Processing...';
        fetch('https://quickdtf-pricing-engine.netlify.app/.netlify/functions/create-pricing-order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            designs: [{
              widthIn: popularWidth,
              heightIn: popularHeight,
              qty: qty,
              productType: IS_UV ? 'uv_dtf' : 'dtf',
              fileUrl: fileUrl || '',
              note: (function() {
            var mw = parseFloat((g('qdtf-pop-maxw') && g('qdtf-pop-maxw').textContent) || popularWidth);
            var mh = parseFloat((g('qdtf-pop-maxh') && g('qdtf-pop-maxh').textContent) || popularHeight);
            return mw.toFixed(2) + '"' + ' x ' + mh.toFixed(2) + '"' + ' x ' + qty + ' pcs - ' + Math.round(tier.discount * 100) + '% off';
          })()
            }]
          })
        })
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (!d.checkoutUrl) throw new Error(d.error || 'Failed');
          var props = {
            'Size': sizeLabel,
            'Quantity': String(qty),
            'Unit Price': fmt(unit) + '/piece',
            'Discount': Math.round(tier.discount * 100) + '% off',
            'Total': fmt(tot),
            '_draft_checkout_url': d.checkoutUrl,
            '_draft_order_id': String(d.draftOrderId || ''),
            '_design_file': fileUrl || ''
          };
          if (fileUrl) props['Design File'] = fileUrl;
          return fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: VARIANT_ID, quantity: 1, properties: props })
          });
        })
        .then(function() {
          btn.disabled = false; btn.innerHTML = '✓ Added!'; btn.style.background = '#16A34A';
          // Enable checkout button
          var checkoutBtn = g('qdtf-checkout-btn');
          if (checkoutBtn) {
            checkoutBtn.disabled = false;
            checkoutBtn.dataset.checkoutUrl = ''; // will be set per flow
          }
          openCartDrawer();
          setTimeout(function() { btn.style.background = ''; btn.innerHTML = orig; }, 2000);
        })
        .catch(function() {
          btn.disabled = false; btn.innerHTML = orig;
          alert('Something went wrong. Please try again.');
        });
      }
      return;
    }
    // -- CUSTOM SIZE -- create draft order then add placeholder to cart
    var w = getW(), h = getH();
    if (w <= 0 || h <= 0) { alert('Please enter width and height.'); return; }
    btn.disabled = true; btn.innerHTML = 'Processing...';
    fetch('https://quickdtf-pricing-engine.netlify.app/.netlify/functions/create-pricing-order', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        designs: [{
          widthIn: w,
          heightIn: h,
          qty: qty,
          productType: IS_UV ? 'uv_dtf' : 'dtf',
          fileUrl: fileUrl || '',
          note: w.toFixed(2) + '" x ' + h.toFixed(2) + '" (Custom)'
        }]
      })
    })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      if (!d.checkoutUrl) throw new Error(d.error || 'Failed');
      var props = {
        'Size': w.toFixed(2) + '" x ' + h.toFixed(2) + '" (Custom)',
        'Quantity': String(qty),
        'Unit Price': fmt(unit) + '/piece',
        'Total': fmt(tot),
        '_draft_checkout_url': d.checkoutUrl,
        '_draft_order_id': String(d.draftOrderId || ''),
        '_design_file': fileUrl || ''
      };
      if (tier.discount > 0) props['Discount'] = Math.round(tier.discount * 100) + '% off';
      if (fileUrl) props['Design File'] = fileUrl;
      return fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: VARIANT_ID, quantity: 1, properties: props })
      });
    })
    .then(function() {
      btn.disabled = false; btn.innerHTML = '✓ Added!'; btn.style.background = '#16A34A';
      openCartDrawer();
      setTimeout(function() { btn.style.background = ''; btn.innerHTML = orig; }, 2000);
    })
    .catch(function() {
      btn.disabled = false; btn.innerHTML = orig;
      alert('Something went wrong. Please try again.');
    });
  });

  // ── Init Uploadcare ────────────────────────────────────────────────────────
  function initUC() {
    if (!window.uploadcare) return false;
    try {
      // Get the widget instance Uploadcare already rendered for the input
      // Using '#qdtf-uc-input' selector to match the exact input
      var widget = uploadcare.Widget('#qdtf-uc-input');
      if (!widget) return false;

      // Check current value (in case file already set)
      var currentFile = widget.value();
      if (currentFile) {
        currentFile.done(function(info) { onUploadComplete(info); });
      }

      widget.onChange(function(file) {
        if (file) {
          file.done(function(info) { onUploadComplete(info); });
        } else {
          onUploadCleared();
        }
      });

      console.log('[QDTF] Uploadcare connected ✓');
      return true;
    } catch(e) {
      console.warn('[QDTF] initUC failed:', e);
      return false;
    }
  }

  // Retry until uploadcare is ready
  if (!initUC()) {
    var _t = setInterval(function() {
      if (initUC()) clearInterval(_t);
    }, 200);
    setTimeout(function() { clearInterval(_t); }, 15000);
  }


  // ── Checkout button ───────────────────────────────────────────────────────
  var checkoutBtn = g('qdtf-checkout-btn');
  if (checkoutBtn) {
    checkoutBtn.addEventListener('click', function() {
      // Check cart for draft order URL
      fetch('/cart.js')
        .then(function(r) { return r.json(); })
        .then(function(cart) {
          var draftUrl = null;
          (cart.items || []).forEach(function(item) {
            if (item.properties && item.properties['_draft_checkout_url']) {
              draftUrl = item.properties['_draft_checkout_url'];
            }
          });
          window.location.href = draftUrl || '/checkout';
        });
    });
  }

  // ── Easify Bridge ─────────────────────────────────────────────────────────
  function getEasifyInputs() {
    var dims = document.querySelectorAll('.po-dimension-inputField');

    var qty = document.querySelector(
      '.po-quantity-inputField, ' +
      'input[class*="quantity"][class*="po-"], ' +
      '.easify input[type="number"]:not(.po-dimension-inputField), ' +
      '.easify-product-options input[type="number"]:not(.po-dimension-inputField)'
    );

    return {
      w: dims[0] || null,
      h: dims[1] || null,
      qty: qty || null
    };
  }

  function setNativeVal(el, val) {
    if (!el) return false;

    var proto = el.tagName === 'SELECT'
      ? window.HTMLSelectElement.prototype
      : window.HTMLInputElement.prototype;

    var descriptor = Object.getOwnPropertyDescriptor(proto, 'value');
    if (descriptor && descriptor.set) descriptor.set.call(el, String(val));
    else el.value = String(val);

    el.dispatchEvent(new Event('input',  { bubbles: true }));
    el.dispatchEvent(new Event('change', { bubbles: true }));
    el.dispatchEvent(new Event('blur',   { bubbles: true }));
    return true;
  }

  function setEasifyDimensions(w, h) {
    var inputs = getEasifyInputs();
    if (!inputs.w || !inputs.h) {
      console.warn('[QDTF] Easify dimension inputs were not found');
      return false;
    }

    // Send the REAL dimensions. Easify Premium Quantity discounts must
    // apply the tier discount; do not fake discounts by changing width.
    setNativeVal(inputs.w, Math.round(w * 10000) / 10000);
    setNativeVal(inputs.h, Math.round(h * 10000) / 10000);
    return true;
  }

  function setEasifyQty(qty) {
    var inputs = getEasifyInputs();

    if (inputs.qty) setNativeVal(inputs.qty, qty);

    // Keep Shopify's actual line quantity synchronized as well.
    document.querySelectorAll('form[action*="/cart/add"] input[name="quantity"]').forEach(function(input) {
      if (!input.closest('.qdtf-calc')) setNativeVal(input, qty);
    });
  }

  function getProductForm() {
    var forms = Array.prototype.slice.call(
      document.querySelectorAll('form[action*="/cart/add"]')
    );

    return forms.find(function(form) {
      return !form.closest('sticky-add-to-cart') &&
             !form.closest('.sticky-add-to-cart') &&
             !!form.querySelector('input[name="id"]');
    }) || forms[0] || null;
  }

  function setProductVariant(variantId) {
    if (!variantId) return;

    var form = getProductForm();
    if (!form) return;

    var variantInput = form.querySelector('input[name="id"], select[name="id"]');
    if (variantInput) setNativeVal(variantInput, variantId);

    var nativePicker = document.querySelector('variant-picker select, select[name="id"]');
    if (nativePicker && nativePicker !== variantInput) {
      setNativeVal(nativePicker, variantId);
    }
  }

  function syncLineItemProperties() {
    var form = getProductForm();
    if (!form) return false;

    var width  = MODE === 'popular' ? popularWidth  : getW();
    var height = MODE === 'popular' ? popularHeight : getH();

    var properties = {
      'Design File': fileUrl || '',
      'Width': width > 0 ? width.toFixed(2) + ' in' : '',
      'Height': height > 0 ? height.toFixed(2) + ' in' : '',
      'Print Size': width > 0 && height > 0
        ? width.toFixed(2) + '" × ' + height.toFixed(2) + '"'
        : '',
      'Size Type': MODE === 'popular' ? 'Popular Size' : 'Custom Size'
    };

    Object.keys(properties).forEach(function(label) {
      var name = 'properties[' + label + ']';
      var input = form.querySelector('input[name="' + name.replace(/"/g, '\\"') + '"]');

      if (!input) {
        input = document.createElement('input');
        input.type = 'hidden';
        input.name = name;
        form.appendChild(input);
      }

      input.value = properties[label];
    });

    return true;
  }

  function submitEasifyProductForm() {
    var form = getProductForm();
    if (!form) {
      console.warn('[QDTF] Main product form was not found');
      return false;
    }

    syncLineItemProperties();

    var submit = form.querySelector(
      'button[type="submit"]:not(.sticky-add-to-cart__button), ' +
      'button[name="add"]:not(.sticky-add-to-cart__button), ' +
      'input[type="submit"]'
    );

    console.log('[QDTF] Submitting native product form');

    if (typeof form.requestSubmit === 'function') {
      form.requestSubmit(submit || undefined);
    } else if (submit) {
      submit.click();
    } else {
      form.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true }));
    }

    return true;
  }

  // Sync Easify whenever our W/H/qty changes
  var _easifySyncTimer = null;
  function scheduleEasifySync() {
    clearTimeout(_easifySyncTimer);
    _easifySyncTimer = setTimeout(function() {
      var w = MODE === 'popular' ? popularWidth : getW();
      var h = MODE === 'popular' ? popularHeight : getH();
      var qty = getQty();
      if (w > 0 && h > 0) setEasifyDimensions(w, h);
      setEasifyQty(qty);
    }, 50);
  }

  // Initial render
  update();
  
  // Sync Easify on first load with default values
  setTimeout(function() {
    var w = getW(), h = getH();
    if (w > 0 && h > 0) setEasifyDimensions(w, h);
  }, 500);

  // ── PREVIEW MODAL ──────────────────────────────────────────────────────────
  var modalAspectRatio = 1; // W/H ratio
  var modalLocked      = true;
  var MODAL_RATE       = RATE;

  function openModal(cdnUrl, wIn, hIn) {
    var modal = g('qdtf-preview-modal');
    if (!modal) return;

    var img = g('qdtf-preview-img');
    if (img) img.src = cdnUrl + '-/preview/1200x1200/';

    if (wIn > 0 && hIn > 0) modalAspectRatio = wIn / hIn;
    setModalW(wIn);
    setModalH(hIn);
    updateModalPrice();

    modal.style.display = 'flex';
    modal.classList.add('qdtf-modal--open');
    document.body.style.overflow = 'hidden';

    // Init free transform after image loads
    var previewImg = g('qdtf-preview-img');
    if (previewImg) {
      var initFT = function() { initFreeTransform(wIn, hIn); };
      if (previewImg.complete) initFT();
      else previewImg.onload = initFT;
    }
  }

  // ── Free Transform ──────────────────────────────────────────────────────────
  function initFreeTransform(wIn, hIn) {
    var canvas  = g('qdtf-canvas');
    var img     = g('qdtf-preview-img');
    if (!canvas || !img) return;

    // Set initial size based on aspect ratio
    var wrap    = canvas.parentElement;
    var maxW    = wrap.clientWidth  * 0.7;
    var maxH    = wrap.clientHeight * 0.7;
    var ratio   = modalAspectRatio || (wIn / hIn) || 1;
    var initW   = Math.min(maxW, maxH * ratio);
    var initH   = initW / ratio;

    canvas.style.width  = Math.round(initW) + 'px';
    canvas.style.height = Math.round(initH) + 'px';
    img.style.width     = '100%';
    img.style.height    = '100%';

    // Drag to move
    var dragStart = null;
    var canvasPos = { x: 0, y: 0 };
    canvas.style.transform = 'translate(0px, 0px)';

    canvas.addEventListener('mousedown', function(e) {
      if (e.target.classList.contains('qdtf-resize-handle')) return;
      dragStart = { mx: e.clientX, my: e.clientY, cx: canvasPos.x, cy: canvasPos.y };
      canvas.classList.add('dragging');
      e.preventDefault();
    });

    document.addEventListener('mousemove', function(e) {
      if (!dragStart) return;
      canvasPos.x = dragStart.cx + (e.clientX - dragStart.mx);
      canvasPos.y = dragStart.cy + (e.clientY - dragStart.my);
      canvas.style.transform = 'translate(' + canvasPos.x + 'px,' + canvasPos.y + 'px)';
    });

    document.addEventListener('mouseup', function() {
      dragStart = null;
      canvas.classList.remove('dragging');
    });

    // Corner resize
    var handles = canvas.querySelectorAll('.qdtf-resize-handle');
    handles.forEach(function(handle) {
      handle.addEventListener('mousedown', function(e) {
        e.stopPropagation();
        e.preventDefault();
        var startX  = e.clientX;
        var startW  = canvas.offsetWidth;
        var corner  = handle.getAttribute('data-corner');
        var isLeft  = corner === 'nw' || corner === 'sw';

        function onMove(ev) {
          var dx   = ev.clientX - startX;
          var newW = Math.max(80, isLeft ? startW - dx : startW + dx);
          var newH = newW / modalAspectRatio;
          canvas.style.width  = Math.round(newW) + 'px';
          canvas.style.height = Math.round(newH) + 'px';

          // Update dimension inputs from pixel size
          // 1 inch = some pixel count — we scale relative to original
          var scale  = newW / initW;
          var nwIn   = Math.round(wIn * scale * 100) / 100;
          var nhIn   = Math.round(hIn * scale * 100) / 100;
          nwIn = Math.min(22, Math.max(0.25, nwIn));
          nhIn = Math.max(0.25, nhIn);
          setModalW(nwIn);
          setModalH(nhIn);
          updateModalPrice();
        }

        function onUp() {
          document.removeEventListener('mousemove', onMove);
          document.removeEventListener('mouseup', onUp);
        }

        document.addEventListener('mousemove', onMove);
        document.addEventListener('mouseup', onUp);
      });
    });

    // Touch support for mobile
    canvas.addEventListener('touchstart', function(e) {
      if (e.target.classList.contains('qdtf-resize-handle')) return;
      var t = e.touches[0];
      dragStart = { mx: t.clientX, my: t.clientY, cx: canvasPos.x, cy: canvasPos.y };
      e.preventDefault();
    }, { passive: false });

    document.addEventListener('touchmove', function(e) {
      if (!dragStart) return;
      var t = e.touches[0];
      canvasPos.x = dragStart.cx + (t.clientX - dragStart.mx);
      canvasPos.y = dragStart.cy + (t.clientY - dragStart.my);
      canvas.style.transform = 'translate(' + canvasPos.x + 'px,' + canvasPos.y + 'px)';
    }, { passive: false });

    document.addEventListener('touchend', function() { dragStart = null; });
  }

  function closeModal() {
    var modal = g('qdtf-preview-modal');
    if (modal) {
      modal.style.display = 'none';
      modal.classList.remove('qdtf-modal--open');
    }
    document.body.style.overflow = '';
  }

  function setModalW(val) {
    var el = g('qdtf-modal-width');
    if (el) el.value = parseFloat(val).toFixed(2);
  }

  function setModalH(val) {
    var el = g('qdtf-modal-height');
    if (el) el.value = parseFloat(val).toFixed(2);
  }

  function getModalW() { return parseFloat((g('qdtf-modal-width') && g('qdtf-modal-width').value) || 0); }
  function getModalH() { return parseFloat((g('qdtf-modal-height') && g('qdtf-modal-height').value) || 0); }

  function updateModalPrice() {
    var w    = getModalW();
    var h    = getModalH();
    var sqin = Math.round(w * h * 100) / 100;
    var price = Math.round(w * h * MODAL_RATE * 10000) / 10000;
    if (g('qdtf-modal-sqin'))  g('qdtf-modal-sqin').textContent  = sqin + ' sq in';
    if (g('qdtf-modal-price')) g('qdtf-modal-price').textContent = '$' + price.toFixed(4);
  }

  // Lock button toggle
  // Modal lock — locked by default, customer can toggle
  var lockBtn = g('qdtf-modal-lock');
  if (lockBtn) {
    lockBtn.addEventListener('click', function() {
      modalLocked = !modalLocked;
      this.classList.toggle('unlocked', !modalLocked);
      var label = g('qdtf-lock-label');
      if (label) {
        label.textContent = modalLocked ? 'Aspect ratio locked' : 'Aspect ratio unlocked';
        label.classList.toggle('unlocked', !modalLocked);
      }
      if (!modalLocked) {
        var w = getModalW(), h = getModalH();
        if (h > 0) modalAspectRatio = w / h;
      }
    });
    lockBtn.title = 'Aspect ratio locked — click to unlock';
  }

  // Modal spinner buttons
  document.addEventListener('click', function(e) {
    var btn = e.target.closest('.qdtf-modal__spin-btn');
    if (!btn) return;
    var id  = btn.getAttribute('data-modal-target');
    var dir = parseFloat(btn.getAttribute('data-dir'));
    var inp = g(id);
    if (!inp) return;
    var step = parseFloat(inp.step) || 0.25;
    var min  = parseFloat(inp.min)  || 0.5;
    var max  = parseFloat(inp.max)  || Infinity;
    var val  = Math.round(((parseFloat(inp.value) || 0) + dir * step) * 100) / 100;
    val = Math.max(min, Math.min(max, val));
    inp.value = val.toFixed(2);

    // Apply aspect ratio lock
    if (modalLocked) {
      if (id === 'qdtf-modal-width') {
        var newH = Math.round((val / modalAspectRatio) * 100) / 100;
        setModalH(Math.max(0.5, newH));
      } else {
        var newW = Math.round((val * modalAspectRatio) * 100) / 100;
        setModalW(Math.min(22, Math.max(0.5, newW)));
      }
    }
    updateModalPrice();
  });

  // Manual input change with aspect ratio lock
  ['qdtf-modal-width', 'qdtf-modal-height'].forEach(function(id) {
    var inp = g(id);
    if (!inp) return;
    inp.addEventListener('change', function() {
      if (modalLocked) {
        var val = parseFloat(this.value) || 0;
        if (id === 'qdtf-modal-width') {
          setModalH(Math.max(0.5, Math.round(val / modalAspectRatio * 100) / 100));
        } else {
          setModalW(Math.min(22, Math.max(0.5, Math.round(val * modalAspectRatio * 100) / 100)));
        }
      }
      updateModalPrice();
    });
  });

  // Close on backdrop or close button
  var backdrop = g('qdtf-modal-backdrop');
  var closeBtn = g('qdtf-modal-close');
  if (backdrop) backdrop.addEventListener('click', closeModal);
  if (closeBtn) closeBtn.addEventListener('click', closeModal);

  // ESC key closes modal
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeModal();
  });

  // Confirm button — apply dimensions to calculator and close
  var confirmBtn = g('qdtf-modal-confirm');
  if (confirmBtn) confirmBtn.addEventListener('click', function() {
    var w = getModalW();
    var h = getModalH();
    if (g('qdtf-width'))  g('qdtf-width').value  = w.toFixed(2);
    if (g('qdtf-height')) g('qdtf-height').value = h.toFixed(2);
    closeModal();
    // Show calculator body and update
    if (g('qdtf-calc-body')) g('qdtf-calc-body').style.display = 'flex';
    update();
  });

  // Re-upload button
  var reuploadBtn = g('qdtf-modal-reupload');
  if (reuploadBtn) reuploadBtn.addEventListener('click', function() {
    closeModal();
    // Trigger uploadcare widget
    var inp = g('qdtf-uc-input');
    if (window.uploadcare && inp) {
      var widget = uploadcare.Widget(inp);
      if (widget) widget.openDialog();
    }
  });

})();
</script>


