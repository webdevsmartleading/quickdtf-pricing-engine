  // ── Spinners ───────────────────────────────────────────────────────────────
  document.addEventListener('click', function(e) {
    var btn = e.target.closest('.qdtf-calc__spin-btn');
    if (!btn) return;
    var id  = btn.getAttribute('data-target');
    var dir = parseFloat(btn.getAttribute('data-dir'));
    var inp = g(id);
    if (!inp) return;
    var step = parseFloat(inp.step) || 1;
    var min  = parseFloat(inp.min)  || 0;
    var max  = parseFloat(inp.max)  || Infinity;
    var val  = Math.round(((parseFloat(inp.value) || 0) + dir * step) * 1000) / 1000;
    val = Math.max(min, Math.min(max, val));
    inp.value = id === 'qdtf-qty' ? Math.round(val) : val.toFixed(2);

    // Apply aspect ratio lock on width/height
    if (calcLocked && id !== 'qdtf-qty') {
      if (id === 'qdtf-width') {
        var newH = Math.round(val / calcAspectRatio * 100) / 100;
        var hEl = g('qdtf-height');
        if (hEl) hEl.value = Math.max(0.5, newH).toFixed(2);
      } else if (id === 'qdtf-height') {
        var newW = Math.round(val * calcAspectRatio * 100) / 100;
        var wEl = g('qdtf-width');
        if (wEl) wEl.value = Math.min(22, Math.max(0.5, newW)).toFixed(2);
      }
    }
    update();
  });

  // Input events on all three fields
  ['qdtf-width','qdtf-height','qdtf-qty'].forEach(function(id) {
