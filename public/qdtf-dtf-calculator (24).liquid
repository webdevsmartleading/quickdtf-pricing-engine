        if (fileUrl) props['Design File'] = fileUrl;
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: popularVariantId, quantity: qty, properties: props })
        })
        .then(function(r) { return r.json(); })
        .then(function() {
          btn.disabled = false; btn.innerHTML = '✓ Added!'; btn.style.background = '#16A34A';
          // Wait briefly for Shopify cart to update before opening drawer
          setTimeout(function() {
            fetch('/cart.js').then(function(r) { return r.json(); }).then(function(cart) {
              // Dispatch Horizon cart update event with fresh cart data
              document.dispatchEvent(new CustomEvent('cart:add', {
                bubbles: true,
                detail: { resource: cart }
              }));

              // Update cart count badge
              document.querySelectorAll('cart-icon-bubble').forEach(function(el) {
                var countEl = el.querySelector('[aria-label]') || el;
                countEl.setAttribute('aria-label', cart.item_count + ' items');
              });

