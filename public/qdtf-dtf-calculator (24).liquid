  if (calcLockBtn) {
    calcLockBtn.addEventListener('click', function() {
      calcLocked = !calcLocked;
      this.classList.toggle('unlocked', !calcLocked);
      this.title = calcLocked ? 'Aspect ratio locked — click to unlock' : 'Aspect ratio unlocked — click to lock';
      // Update ratio from current values when unlocking
      if (!calcLocked) {
        var w = getW(), h = getH();
        if (h > 0) calcAspectRatio = w / h;
      }
