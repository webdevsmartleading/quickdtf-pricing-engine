{% if product.tags contains 'dtf-upload' and product.tags contains 'dtf-by-size' or product.tags contains 'dtf-upload' and product.tags contains 'uv-by-size' %}
{% liquid
  assign is_uv = false
  if product.tags contains 'uv-dtf' or product.tags contains 'uv-by-size'
    assign is_uv = true
  endif

  if is_uv
    assign rate = 0.120
    assign product_type = 'uv_dtf'
  else
    assign rate = 0.030
    assign product_type = 'dtf'
  endif
%}

<style>
  /* Hide native variant picker, price display on calculator products only */
  .qdtf-calc-active variant-picker,
  .qdtf-calc-active .variant-picker,
  .qdtf-calc-active [data-block-type="variant_picker"] {
    display: none !important;
  }

  /* Price block — hide the default and restyle via our own display */
  .qdtf-calc-active product-price {
    display: none !important;
  }
</style>

<script>
  // Hide native variant picker and price on calculator products
  (function() {
    function hideNativeElements() {
      // Hide variant picker (size dropdown)
      document.querySelectorAll('variant-picker').forEach(function(el) {
        el.style.setProperty('display', 'none', 'important');
      });
      // Hide native price block
      document.querySelectorAll('product-price').forEach(function(el) {
        el.style.setProperty('display', 'none', 'important');
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', hideNativeElements);
    } else {
      hideNativeElements();
    }
  })();
</script>

<div class="qdtf-calc" data-rate="{{ rate }}" data-product-type="{{ product_type }}" {{ block.shopify_attributes }}>

  <!-- UPLOAD ZONE -->
  <div class="qdtf-calc__upload-zone" id="qdtf-upload-zone">

    <!-- Idle state -->
    <div class="qdtf-calc__upload-idle" id="qdtf-upload-idle">
      <!-- Drop zone UI on top, Uploadcare widget below it -->
      <div class="qdtf-file-dropzone">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="48" height="48">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" stroke="#1A56F0" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          <polyline points="17 8 12 3 7 8" stroke="#1A56F0" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          <line x1="12" y1="3" x2="12" y2="15" stroke="#1A56F0" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <p class="qdtf-file-title">
          {% if product.tags contains 'dtf-by-size' or product.tags contains 'uv-by-size' %}Upload Your Design{% elsif product.tags contains 'uv-dtf' %}Upload Your UV DTF Gang Sheet{% else %}Upload Your Gang Sheet{% endif %}
          <span style="color:#DC2626;">*</span>
        </p>
        <p class="qdtf-file-hint">PNG only · Transparent bg · 300 DPI minimum</p>
      </div>

      <!-- Uploadcare widget -->
      <script>
        window.UPLOADCARE_PUBLIC_KEY = 'be9a69484bdbe62f5b29';
        window.UPLOADCARE_LIVE = true;
        window.UPLOADCARE_MANUAL_START = false;
        (function() {
          if (window.__qdtfUcLoaded) return;
          window.__qdtfUcLoaded = true;
          var s = document.createElement('script');
          s.src = 'https://ucarecdn.com/libs/widget/3.x/uploadcare.full.min.js';
          s.charset = 'UTF-8';
          s.onload = function() {
            // Script loaded — now init the widget
            window.__qdtfUcReady = true;
          };
          document.head.appendChild(s);
        })();
      </script>

      <input
        type="hidden"
        role="uploadcare-uploader"
        name="properties[Design File]"
        id="qdtf-uc-input"
        data-public-key="be9a69484bdbe62f5b29"
        data-images-only="true"
        data-preview-step="true"
        data-clearable="true"
      />
    </div>

    <!-- Done state -->
    <div class="qdtf-calc__upload-done" id="qdtf-upload-done" style="display:none;">
      <div class="qdtf-upload-card">
        <!-- Thumbnail -->
        <div class="qdtf-upload-card__thumb-wrap">
          <img id="qdtf-thumb" src="" alt="Uploaded design" class="qdtf-upload-card__thumb">
        </div>
        <!-- Title -->
        <span id="qdtf-filename" class="qdtf-upload-card__name">design.png</span>
        <!-- Three action buttons -->
        <div class="qdtf-upload-card__actions">
          <button type="button" class="qdtf-upload-card__btn qdtf-upload-card__btn--view" id="qdtf-open-preview">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            View
          </button>
          <button type="button" class="qdtf-upload-card__btn qdtf-upload-card__btn--redetect" id="qdtf-redetect">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
            Re-detect
          </button>
          <button class="qdtf-upload-card__btn qdtf-upload-card__btn--remove" id="qdtf-remove-file" type="button">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
            Remove
          </button>
        </div>
      </div>
    </div>

  </div>

  <!-- CALCULATOR BODY (hidden until upload) -->
  <div class="qdtf-calc__body" id="qdtf-calc-body" style="display:none;">



    <!-- TABS -->
    <div class="qdtf-calc__tabs">
      <div class="qdtf-tab-container">
        <input type="radio" name="qdtf-tab" id="qdtf-tab1" class="qdtf-tab qdtf-tab--1" checked>
        <label class="qdtf-tab-label" for="qdtf-tab1">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          Custom Size
        </label>
        <input type="radio" name="qdtf-tab" id="qdtf-tab2" class="qdtf-tab qdtf-tab--2">
        <label class="qdtf-tab-label" for="qdtf-tab2">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
          Popular Sizes
        </label>
        <div class="qdtf-indicator"></div>
      </div>
    </div>

    <!-- TAB 1: CUSTOM SIZE -->
    <div class="qdtf-calc__panel" id="qdtf-panel-custom">
      <p class="qdtf-calc__auto-label">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#1A56F0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        Auto-detected from your file. Adjust if needed.
      </p>
      <div class="qdtf-calc__size-inputs">
        <div class="qdtf-calc__size-field">
          <label class="qdtf-calc__size-label">Width (in)</label>
          <div class="qdtf-calc__spinner">
            <button type="button" class="qdtf-calc__spin-btn" data-target="qdtf-width" data-dir="-1">−</button>
            <input type="number" id="qdtf-width" class="qdtf-calc__spin-input" value="4.00" min="0.5" max="22" step="0.25">
            <button type="button" class="qdtf-calc__spin-btn" data-target="qdtf-width" data-dir="1">+</button>
          </div>
        </div>
        <div class="qdtf-calc__size-mid">
          <div class="qdtf-calc__size-x">×</div>
          <button type="button" class="qdtf-calc__lock-btn" id="qdtf-calc-lock" title="Lock aspect ratio">
            <svg id="qdtf-calc-lock-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
          </button>
        </div>
        <div class="qdtf-calc__size-field">
          <label class="qdtf-calc__size-label">Height (in)</label>
          <div class="qdtf-calc__spinner">
            <button type="button" class="qdtf-calc__spin-btn" data-target="qdtf-height" data-dir="-1">−</button>
            <input type="number" id="qdtf-height" class="qdtf-calc__spin-input" value="4.00" min="0.5" max="500" step="0.25">
            <button type="button" class="qdtf-calc__spin-btn" data-target="qdtf-height" data-dir="1">+</button>
          </div>
        </div>
        <div class="qdtf-calc__size-eq">
          <span class="qdtf-calc__sqin" id="qdtf-sqin">16 sq in</span>
          <span class="qdtf-calc__rate">× ${{ rate }}</span>
        </div>
      </div>
    </div>

    <!-- TAB 2: POPULAR SIZES — Shopify variants in dropdown format -->
    <div class="qdtf-calc__panel" id="qdtf-panel-popular" style="display:none;">
      <label class="qdtf-calc__size-label" for="qdtf-popular-size">Select a size</label>
      <div class="qdtf-calc__select-wrap">
        <select id="qdtf-popular-size" class="qdtf-calc__select">
          <option value="">— Choose a size —</option>
          {% for variant in product.variants %}
            {%- assign clean = variant.title | replace: '"', '' | replace: "'", '' -%}
            {%- assign parts = clean | split: ' x ' -%}
            {%- if parts.size == 2 -%}
              {%- assign pw = parts[0] | strip | times: 1.0 -%}
              {%- assign ph = parts[1] | strip | times: 1.0 -%}
              <option
                value="{{ variant.id }}"
                data-w="{{ pw }}"
                data-h="{{ ph }}"
                data-price="{{ variant.price | divided_by: 100.0 }}"
              >
                {{ variant.title }}
              </option>
            {%- endif -%}
          {% endfor %}
        </select>
        <svg class="qdtf-calc__select-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
      </div>

      <!-- Max print size display — appears after selecting a preset -->
      <div class="qdtf-popular-size-adj" id="qdtf-popular-adj" style="display:none;">
        <p class="qdtf-calc__auto-label">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#1A56F0" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          Maximum print size for your image in this size.
        </p>
        <div class="qdtf-popular-maxsize">
          <div class="qdtf-popular-maxsize__dim">
            <span class="qdtf-popular-maxsize__val" id="qdtf-pop-maxw">—</span>
            <span class="qdtf-popular-maxsize__unit">in W</span>
          </div>
          <div class="qdtf-popular-maxsize__x">×</div>
          <div class="qdtf-popular-maxsize__dim">
            <span class="qdtf-popular-maxsize__val" id="qdtf-pop-maxh">—</span>
            <span class="qdtf-popular-maxsize__unit">in H</span>
          </div>
          <div class="qdtf-popular-maxsize__sqin">
            = <span id="qdtf-pop-sqin">—</span> sq in
          </div>
        </div>
      </div>
    </div>

    <!-- QTY + PRICE ROW -->
    <div class="qdtf-calc__qty-row">
      <div class="qdtf-calc__qty-wrap">
        <label class="qdtf-calc__size-label">Quantity</label>
        <div class="qdtf-calc__spinner">
          <button type="button" class="qdtf-calc__spin-btn" data-target="qdtf-qty" data-dir="-1">−</button>
          <input type="number" id="qdtf-qty" class="qdtf-calc__spin-input" value="1" min="1" step="1">
          <button type="button" class="qdtf-calc__spin-btn" data-target="qdtf-qty" data-dir="1">+</button>
        </div>
      </div>
      <div class="qdtf-calc__unit-price">
        <label class="qdtf-calc__size-label">Price per piece</label>
        <span class="qdtf-calc__unit-val" id="qdtf-unit-price">$0.24</span>
      </div>
      <div class="qdtf-calc__total">
        <label class="qdtf-calc__size-label">Total</label>
        <span class="qdtf-calc__total-val" id="qdtf-total">$0.24</span>
      </div>
    </div>

    <!-- BULK DISCOUNT TABLE -->
    <div class="qdtf-calc__discount-wrap">
      <div class="qdtf-calc__discount-header">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#1A56F0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        Buy More & Save — Cumulative Discounts
      </div>
      <table class="qdtf-calc__table">
        <thead>
          <tr>
            <th>Total Qty</th>
            <th>Price ea</th>
            <th>Discount</th>
          </tr>
        </thead>
        <tbody id="qdtf-discount-tbody">
          <!-- filled by JS -->
        </tbody>
      </table>
      <p class="qdtf-calc__next-tier" id="qdtf-next-tier"></p>
    </div>

    <!-- ADD TO CART -->
    <button type="button" class="qdtf-calc__atc" id="qdtf-atc-btn">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
      Add to Cart — <span id="qdtf-atc-price">$0.24</span>
    </button>

    <p class="qdtf-calc__note">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      No minimums, setup or art fees. Final price adjusted to match your discount tier at checkout.
    </p>

  </div>
</div>

<style>
  /* ── WRAPPER ── */
  .qdtf-calc {
    width: 100%;
    font-family: var(--font-body--family, sans-serif);
    color: #0A0A0A;
  }

  /* ── UPLOAD ZONE ── */
  .qdtf-calc__upload-zone {
    width: 100%;
  }

  .qdtf-calc__upload-idle {
    width: 100%;
  }

  /* Drop zone decorative area */
  .qdtf-file-dropzone {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    text-align: center;
    width: 100%;
    background: #EEF3FF;
    padding: 28px 24px 16px;
    border-radius: 16px 16px 0 0;
    border: 2px dashed #1A56F0;
    border-bottom: none;
    box-sizing: border-box;
  }

  .qdtf-file-title {
    font-family: var(--font-heading--family, sans-serif);
    font-size: 15px;
    font-weight: 700;
    color: #0A0A0A;
    margin: 0;
  }

  .qdtf-file-hint {
    font-size: 12px;
    color: #888;
    margin: 0;
  }

  /* Uploadcare widget sits below dropzone visually as one unit */
  #qdtf-upload-idle {
    border: 2px dashed #1A56F0;
    border-radius: 16px;
    overflow: hidden;
    background: #EEF3FF;
  }

  #qdtf-upload-idle .qdtf-file-dropzone {
    border: none;
    border-radius: 0;
    padding-bottom: 12px;
  }

  .qdtf-browse-btn {
    background: #1A56F0;
    color: #fff;
    padding: 7px 20px;
    border-radius: 10px;
    font-family: var(--font-heading--family, sans-serif);
    font-size: 13px;
    font-weight: 600;
    margin-top: 6px;
    transition: background 0.2s ease;
    display: inline-block;
  }

  .qdtf-file-label:hover .qdtf-browse-btn {
    background: #1440C0;
  }

  /* Uploadcare widget — styled to match QuickDTF design */
  #qdtf-upload-idle .uploadcare--widget {
    display: flex;
    justify-content: center;
    margin-top: 12px;
  }

  #qdtf-upload-idle .uploadcare--widget__button_type_open,
  #qdtf-upload-idle .uploadcare--widget__button {
    background: #1A56F0 !important;
    color: #fff !important;
    border: none !important;
    border-radius: 10px !important;
    padding: 9px 24px !important;
    font-size: 13px !important;
    font-weight: 600 !important;
    cursor: pointer !important;
    font-family: var(--font-heading--family, sans-serif) !important;
    transition: background 0.2s ease !important;
    margin-bottom: 15px !important;
  }

  #qdtf-upload-idle .uploadcare--widget__button_type_open:hover,
  #qdtf-upload-idle .uploadcare--widget__button:hover {
    background: #1440C0 !important;
  }

  /* Any other buttons rendered inside the calculator block */
  .qdtf-calc button:not(.qdtf-calc__spin-btn):not(.qdtf-calc__upload-remove):not(.qdtf-calc__atc) {
    background: #1A56F0 !important;
    color: #fff !important;
    border: none !important;
    border-radius: 8px !important;
  }

  /* Hide uploadcare file name display — we show our own */
  #qdtf-upload-idle .uploadcare--widget__file-name,
  #qdtf-upload-idle .uploadcare--widget__text {
    display: none !important;
  }

  /* Upload card — shown after successful upload */
  .qdtf-calc__upload-done { width: 100%; }

  .qdtf-upload-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    background: #EEF3FF;
    border: 1.5px solid #1A56F0;
    border-radius: 14px;
    padding: 16px;
    text-align: center;
  }

  .qdtf-upload-card__thumb-wrap {
    width: 80px;
    height: 80px;
    border-radius: 10px;
    overflow: hidden;
    background: white;
    border: 1.5px solid #C7D7FF;
    background-image:
      linear-gradient(45deg, #e8e8e8 25%, transparent 25%),
      linear-gradient(-45deg, #e8e8e8 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, #e8e8e8 75%),
      linear-gradient(-45deg, transparent 75%, #e8e8e8 75%);
    background-size: 10px 10px;
    background-position: 0 0, 0 5px, 5px -5px, -5px 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .qdtf-upload-card__thumb {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .qdtf-upload-card__name {
    font-family: var(--font-heading--family, sans-serif);
    font-size: 13px;
    font-weight: 600;
    color: #0A0A0A;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .qdtf-upload-card__actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .qdtf-upload-card__btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.15s;
    border: 1.5px solid;
    background: #fff;
  }

  .qdtf-upload-card__btn--view {
    border-color: #1A56F0;
    color: #1A56F0;
  }
  .qdtf-upload-card__btn--view:hover { background: #EEF3FF; }

  .qdtf-upload-card__btn--redetect {
    border-color: #6366F1;
    color: #6366F1;
  }
  .qdtf-upload-card__btn--redetect:hover { background: #EEF2FF; }

  .qdtf-upload-card__btn--remove {
    border-color: #DC2626;
    color: #DC2626;
  }
  .qdtf-upload-card__btn--remove:hover { background: #FEF2F2; }



  /* ── CALC BODY ── */
  .qdtf-calc__body {
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* ── TABS ── */
  .qdtf-tab-container {
    position: relative;
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    padding: 3px;
    background: #E8EEFF;
    border-radius: 11px;
    width: 100%;
  }

  .qdtf-indicator {
    width: 50%;
    height: 34px;
    background: #1A56F0;
    position: absolute;
    top: 3px;
    left: 3px;
    z-index: 1;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(26,86,240,0.3);
    transition: left 0.22s cubic-bezier(.4,0,.2,1);
  }

  .qdtf-tab {
    position: absolute;
    opacity: 0;
    width: 50%;
    height: 34px;
    z-index: 10;
    cursor: pointer;
    margin: 0;
  }

  .qdtf-tab--1 { left: 3px; }
  .qdtf-tab--2 { left: calc(50% + 3px); }

  .qdtf-tab--1:checked ~ .qdtf-indicator { left: 3px; }
  .qdtf-tab--2:checked ~ .qdtf-indicator { left: calc(50% + 0px); }

  .qdtf-tab-label {
    width: 50%;
    height: 34px;
    position: relative;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-family: var(--font-heading--family, sans-serif);
    font-size: 13px;
    font-weight: 600;
    color: #1A56F0;
    opacity: 0.6;
    cursor: pointer;
    border-radius: 8px;
    transition: color 0.2s ease, opacity 0.2s ease;
    user-select: none;
  }

  .qdtf-tab--1:checked ~ .qdtf-tab-label:nth-of-type(1),
  .qdtf-tab--2:checked ~ .qdtf-tab-label:nth-of-type(2) {
    color: #FFFFFF;
    opacity: 1;
  }

