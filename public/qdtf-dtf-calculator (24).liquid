  // Calculate max print size of uploaded image within variant dimensions
  function updatePopMaxSize(variantW, variantH) {
    if (!fileUrl || variantW <= 0 || variantH <= 0) {
      // No image uploaded — just show variant dimensions as max
      var mw = g('qdtf-pop-maxw'), mh = g('qdtf-pop-maxh'), msq = g('qdtf-pop-sqin');
      if (mw) mw.textContent = variantW.toFixed(2);
      if (mh) mh.textContent = variantH.toFixed(2);
      if (msq) msq.textContent = Math.round(variantW * variantH * 100) / 100;
      return;
    }

    // Use image natural dimensions to compute max size within variant box
    var img = new Image();
    img.onload = function() {
      var imgRatio = img.naturalWidth / img.naturalHeight;
      var varRatio = variantW / variantH;
      var maxW, maxH;

      if (imgRatio >= varRatio) {
        // Image is wider — constrain by width
        maxW = variantW;
        maxH = Math.round((variantW / imgRatio) * 100) / 100;
      } else {
        // Image is taller — constrain by height
        maxH = variantH;
        maxW = Math.round((variantH * imgRatio) * 100) / 100;
      }

      var sqin = Math.round(maxW * maxH * 100) / 100;
      var mw = g('qdtf-pop-maxw'), mh = g('qdtf-pop-maxh'), msq = g('qdtf-pop-sqin');
      if (mw) mw.textContent = maxW.toFixed(2);
      if (mh) mh.textContent = maxH.toFixed(2);
      if (msq) msq.textContent = sqin;
    };
    img.src = fileUrl + '-/preview/400x400/';
  }

  // ── Uploadcare ─────────────────────────────────────────────────────────────
  function onUploadComplete(info) {
    fileUrl = info.cdnUrl;
    if (g('qdtf-filename')) g('qdtf-filename').textContent = info.name || 'design.png';

    // Set thumbnail
    var thumb = g('qdtf-thumb');
    if (thumb) {
      thumb.src = info.cdnUrl + '-/preview/200x200/';
      thumb.onerror = function() { thumb.src = info.cdnUrl; };
    }

    // Show done state, hide idle state
    if (g('qdtf-upload-idle')) g('qdtf-upload-idle').style.display = 'none';
    if (g('qdtf-upload-done')) g('qdtf-upload-done').style.setProperty('display', 'flex', 'important');

    // Show done state
    if (g('qdtf-upload-idle')) g('qdtf-upload-idle').style.display = 'none';
    var donEl = g('qdtf-upload-done'); if (donEl) donEl.style.setProperty('display', 'flex', 'important');

    // Always show calc body so customer isn't blocked
    var calcBody = g('qdtf-calc-body');
    if (calcBody) { calcBody.removeAttribute('style'); calcBody.style.setProperty('display', 'flex', 'important'); }

    // Detect image dimensions then open preview modal
    var img = new Image();
    img.onload = function() {
      var wIn = Math.round((img.naturalWidth  / 300) * 100) / 100;
      var hIn = Math.round((img.naturalHeight / 300) * 100) / 100;
      wIn = Math.min(wIn, 22);
      // Set dimensions in calculator immediately
      if (g('qdtf-width'))  g('qdtf-width').value  = wIn.toFixed(2);
      if (g('qdtf-height')) g('qdtf-height').value = hIn.toFixed(2);
      update();
      // Store aspect ratio
      if (hIn > 0) {
        calcAspectRatio = wIn / hIn;
        modalAspectRatio = wIn / hIn;
      }
      // Open preview modal for customer to confirm/adjust size
      try { openModal(info.cdnUrl, wIn, hIn); }
      catch(err) { console.warn('[QDTF] Modal open failed:', err); }
    };
    img.src = info.cdnUrl + '-/preview/800x800/';
  }

  function onUploadCleared() {
