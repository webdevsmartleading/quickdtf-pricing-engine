<script>
(function() {

  var RATE       = {{ rate }};
  var VARIANT_ID = {{ product.first_available_variant.id }};
  var IS_UV      = {{ is_uv }};
  var MODE    = 'custom';

  var popularVariantId    = null;
  var popularVariantPrice = 0;
  var popularWidth        = 0;
  var popularHeight       = 0;
  var fileUrl             = null;

  var TIERS = [
    { min: 1,   max: 14,       discount: 0    },
    { min: 15,  max: 49,       discount: 0.20 },
    { min: 50,  max: 99,       discount: 0.30 },
    { min: 100, max: 249,      discount: 0.40 },
    { min: 250, max: Infinity, discount: 0.50 }
  ];

  var TIER_LABELS = ['1–14 pcs','15–49','50–99','100–249','250+'];

  function fmt(n) { return '$' + n.toFixed(2); }

  function g(id) { return document.getElementById(id); }

  // ── Core helpers ───────────────────────────────────────────────────────────
  function getW()   { var el = g('qdtf-width');  return el ? (parseFloat(el.value) || 0) : 0; }
  function getH()   { var el = g('qdtf-height'); return el ? (parseFloat(el.value) || 0) : 0; }
  function getQty() { var el = g('qdtf-qty');    return Math.max(1, parseInt((el && el.value) || 1)); }

  function getBase() {
    if (MODE === 'popular') return popularVariantPrice || 0;
    return getW() * getH() * RATE;
  }

  function getTier(qty) {
    return TIERS.find(function(t) { return qty >= t.min && qty <= t.max; }) || TIERS[0];
  }

  function getNextTier(qty) {
    return TIERS.find(function(t) { return t.min > qty; }) || null;
  }

  // ── Update UI ──────────────────────────────────────────────────────────────
  function update() {
    var qty  = getQty();
    var base = Math.round(getBase() * 10000) / 10000;
    var tier = getTier(qty);
    var unit = Math.round(base * (1 - tier.discount) * 10000) / 10000;
    var tot  = Math.round(unit * qty * 100) / 100;

    // Show calc body if file uploaded
    if (fileUrl) {
      var body = g('qdtf-calc-body');
      if (body && body.style.display !== 'flex') body.style.display = 'flex';
    }

    // Sq inches — custom tab only
    if (MODE === 'custom') {
      var sqEl = g('qdtf-sqin');
